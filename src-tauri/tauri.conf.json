{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Ready Room",
	"version": "../package.json",
	"identifier": "io.github.rwolffgang.readyroom",
	"build": {
		"beforeDevCommand": "npm run dev -- --port 1420 --strictPort",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build:desktop",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Ready Room",
				"width": 1440,
				"height": 900,
				"minWidth": 1080,
				"minHeight": 700,
				"backgroundColor": "#05050a"
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["app", "dmg", "nsis"],
		"category": "BoardGame",
		"shortDescription": "Unofficial digital Star Trek: Captain's Chair",
		"copyright": "Code © Robert Wolffgang. Not affiliated with WizKids or CBS.",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"macOS": {
			"signingIdentity": "-",
			"minimumSystemVersion": "11.0"
		},
		"windows": {
			"webviewInstallMode": { "type": "downloadBootstrapper" },
			"nsis": { "installMode": "currentUser" }
		}
	}
}
